#version 430 core

// Fallback for the GPU-resident render path when velocity colouring is off:
// packs device positions into the interleaved vertex layout with a flat colour.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer PositionBuffer { vec2 positions[]; };
layout(std430, binding = 2) buffer VertexBuffer   { float vertices[]; };

uniform int particleCount;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(particleCount)) return;

    uint base = idx * 6;
    vertices[base + 0] = positions[idx].x;
    vertices[base + 1] = positions[idx].y;
    vertices[base + 2] = 0.0;
    vertices[base + 3] = 1.0;
    vertices[base + 4] = 1.0;
    vertices[base + 5] = 1.0;
}

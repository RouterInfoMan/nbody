#version 430 core

// Compacts the boxes the overlay draws and writes the indirect draw command.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer SrcBoxes  { vec4 srcBoxes[]; };
layout(std430, binding = 1) writeonly buffer DstBoxes { vec4 dstBoxes[]; };
layout(std430, binding = 2) coherent buffer DrawCmd   { uint cmd[]; };

uniform int nodeCount;
uniform int capacity;      // in boxes
uniform int maxDepth;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(nodeCount)) return;

    if (i == 0u) {
        vec2 re = srcBoxes[0].zw - srcBoxes[0].xy;
        cmd[4] = floatBitsToUint(max(re.x, re.y));
    }

    vec4 bb = srcBoxes[i];
    vec2 ext = bb.zw - bb.xy;
    float e = max(ext.x, ext.y);

    // Leaves of the GPU tree hold one particle and collapse to a point.
    if (e <= 0.0) return;

    vec4 root = srcBoxes[0];
    vec2 rootExt = root.zw - root.xy;
    float rootE = max(rootExt.x, rootExt.y);
    if (rootE <= 0.0) return;
    if (e < rootE / exp2(float(maxDepth))) return;

    uint base = atomicAdd(cmd[0], 8u);
    uint slot = base >> 3u;
    if (slot < uint(capacity))
        dstBoxes[slot] = bb;
}

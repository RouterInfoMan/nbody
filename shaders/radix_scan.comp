#version 430 core

// Pass 2: exclusive prefix sum over the histogram. One workgroup.

layout(local_size_x = 256) in;

layout(std430, binding = 1) buffer HistBuffer { uint hist[]; };

uniform int histSize;   // 16 * numBlocks

shared uint s_scan[256];

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint running = 0u;

    for (uint base = 0u; base < uint(histSize); base += 256u) {
        uint idx = base + lid;
        uint v = (idx < uint(histSize)) ? hist[idx] : 0u;

        s_scan[lid] = v;
        barrier();

        // Hillis-Steele inclusive scan.
        for (uint off = 1u; off < 256u; off <<= 1) {
            uint t = (lid >= off) ? s_scan[lid - off] : 0u;
            barrier();
            s_scan[lid] += t;
            barrier();
        }

        uint exclusive = s_scan[lid] - v;
        uint chunkTotal = s_scan[255];
        barrier();

        if (idx < uint(histSize))
            hist[idx] = running + exclusive;

        running += chunkTotal;
    }
}

#version 430 core

// Bottom-up centre-of-mass and AABB propagation.
//
// One thread per leaf. Each thread seeds its leaf then walks toward the root,
// atomically incrementing a per-node arrival counter. The first child to
// arrive at a node exits; the second finds both children complete and merges
// them, so every internal node is written exactly once, by whichever child
// finished last.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer PositionBuffer { vec2 positions[]; };
layout(std430, binding = 1) readonly buffer MassBuffer     { float masses[]; };
layout(std430, binding = 2) readonly buffer LeftBuffer     { uint nodeLeft[]; };
layout(std430, binding = 3) readonly buffer RightBuffer    { uint nodeRight[]; };
layout(std430, binding = 4) readonly buffer ParentBuffer   { uint nodeParent[]; };
layout(std430, binding = 5) coherent buffer ComBuffer      { vec4 nodeCom[]; };
layout(std430, binding = 6) coherent buffer AabbBuffer     { vec4 nodeAabb[]; };
layout(std430, binding = 7) coherent buffer FlagBuffer     { uint nodeFlags[]; };
// xyz = (Qxx, Qxy, Qyy), the second mass moment about the node's centre of
// mass. A leaf holds one particle, so its moment is exactly zero.
layout(std430, binding = 8) coherent buffer QuadBuffer     { vec4 nodeQuad[]; };

uniform int particleCount;

void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= uint(particleCount)) return;

    uint leaf = uint(particleCount - 1) + k;
    vec2 p = positions[k];
    float m = masses[k];

    nodeCom[leaf] = vec4(p, m, 0.0);
    nodeAabb[leaf] = vec4(p, p);
    nodeQuad[leaf] = vec4(0.0);

    memoryBarrierBuffer();

    uint node = nodeParent[leaf];
    while (node != 0xFFFFFFFFu) {
        // First arrival leaves the merge to the sibling.
        if (atomicAdd(nodeFlags[node], 1u) == 0u) return;
        memoryBarrierBuffer();

        uint l = nodeLeft[node];
        uint r = nodeRight[node];

        vec4 cl = nodeCom[l];
        vec4 cr = nodeCom[r];
        float total = cl.z + cr.z;
        vec2 com = (total > 0.0) ? (cl.xy * cl.z + cr.xy * cr.z) / total
                                 : 0.5 * (cl.xy + cr.xy);
        nodeCom[node] = vec4(com, total, 0.0);

        vec4 al = nodeAabb[l];
        vec4 ar = nodeAabb[r];
        nodeAabb[node] = vec4(min(al.xy, ar.xy), max(al.zw, ar.zw));

        // Parallel axis theorem: each child's moment shifted to the parent's
        // centre of mass.
        vec2 sl = cl.xy - com;
        vec2 sr = cr.xy - com;
        vec3 ql = nodeQuad[l].xyz + cl.z * vec3(sl.x * sl.x, sl.x * sl.y, sl.y * sl.y);
        vec3 qr = nodeQuad[r].xyz + cr.z * vec3(sr.x * sr.x, sr.x * sr.y, sr.y * sr.y);

        // w carries the distance from the box centre to the centre of mass,
        // which the opening test needs; the slot was otherwise padding.
        vec4 bb = nodeAabb[node];
        float offset = length(com - 0.5 * (bb.xy + bb.zw));
        nodeQuad[node] = vec4(ql + qr, offset);

        memoryBarrierBuffer();
        node = nodeParent[node];
    }
}

#version 430 core

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer PositionBuffer { vec2 positions[]; };
layout(std430, binding = 1) buffer VelocityBuffer { vec2 velocities[]; };
layout(std430, binding = 2) buffer VertexBuffer   { float vertices[]; };

uniform int particleCount;

vec3 velocityToColor(vec2 v) {
    float speed = length(v);
    float hue = clamp(log(speed + 1.0) / 5.0, 0.0, 1.0);
    return vec3(
        clamp(abs(hue * 6.0 - 3.0) - 1.0, 0.0, 1.0),
        clamp(2.0 - abs(hue * 6.0 - 2.0), 0.0, 1.0),
        clamp(2.0 - abs(hue * 6.0 - 4.0), 0.0, 1.0)
    );
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= particleCount) return;

    uint base = idx * 6;
    vertices[base + 0] = positions[idx].x;
    vertices[base + 1] = positions[idx].y;
    vertices[base + 2] = 0.0;

    vec3 color = velocityToColor(velocities[idx]);
    vertices[base + 3] = color.r;
    vertices[base + 4] = color.g;
    vertices[base + 5] = color.b;
}

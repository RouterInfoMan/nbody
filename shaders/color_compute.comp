#version 430 core

// Packs device particle state into the interleaved vertex layout, assigning
// each particle an HDR emission colour.
//
// Colours come from the Planckian locus rather than a hue ramp: mapping a
// scalar to a real blackbody temperature gives the deep reds, ambers, warm
// whites and blue-whites that stars actually span, and those hues composite
// convincingly when thousands of sprites are added together.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer PositionBuffer { vec2 positions[]; };
layout(std430, binding = 1) readonly buffer VelocityBuffer { vec2 velocities[]; };
layout(std430, binding = 2) writeonly buffer VertexBuffer  { float vertices[]; };
layout(std430, binding = 3) readonly buffer MassBuffer     { float masses[]; };
layout(std430, binding = 4) readonly buffer IdBuffer       { uint ids[]; };

uniform int particleCount;
uniform int colorMode;      // 0 speed, 1 mass, 2 monochrome
uniform int hasMass;
// Log-space window the scalar is mapped across, calibrated from the actual
// distribution. A fixed scale does not work: orbital speeds in a galaxy span
// barely a factor of three between core and rim, so any guessed range collapses
// the whole disc into one end of the temperature ramp.
uniform float logLo;
uniform float logHi;
uniform float tempLow;
uniform float tempHigh;
uniform float intensity;
uniform int hasIds;
uniform float variety;

// Planckian locus in CIE 1931 xy (Kim et al. cubic fits), converted to
// linear sRGB. Accurate from roughly 1700K to 25000K.
vec3 blackbody(float kelvin) {
    float t = clamp(kelvin, 1700.0, 25000.0);
    float t2 = t * t;
    float t3 = t2 * t;

    float x = (t < 4000.0)
        ? (-0.2661239e9 / t3 - 0.2343589e6 / t2 + 0.8776956e3 / t + 0.179910)
        : (-3.0258469e9 / t3 + 2.1070379e6 / t2 + 0.2226347e3 / t + 0.240390);

    float x2 = x * x;
    float x3 = x2 * x;

    float y;
    if (t < 2222.0)
        y = -1.1063814 * x3 - 1.34811020 * x2 + 2.18555832 * x - 0.20219683;
    else if (t < 4000.0)
        y = -0.9549476 * x3 - 1.37418593 * x2 + 2.09137015 * x - 0.16748867;
    else
        y =  3.0817580 * x3 - 5.87338670 * x2 + 3.75112997 * x - 0.37001483;

    // xyY (Y = 1) -> XYZ -> linear sRGB.
    float Y = 1.0;
    float X = (Y / y) * x;
    float Z = (Y / y) * (1.0 - x - y);

    vec3 rgb = mat3( 3.2404542, -0.9692660,  0.0556434,
                    -1.5371385,  1.8760108, -0.2040259,
                    -0.4985314,  0.0415560,  1.0572252) * vec3(X, Y, Z);

    rgb = max(rgb, vec3(0.0));
    // Normalise to unit peak so temperature sets hue and `intensity` alone
    // sets brightness.
    return rgb / max(max(rgb.r, max(rgb.g, rgb.b)), 1e-4);
}

// Deterministic per-particle value in [0,1).
float hash01(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return float(x) * (1.0 / 4294967296.0);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(particleCount)) return;

    float t = 0.0;
    if (colorMode != 2) {
        float v = (colorMode == 0) ? length(velocities[idx])
                                   : (hasMass != 0 ? masses[idx] : 1.0);
        // Log spacing still helps: the residual spread within the window is
        // multiplicative, and a few fast escapers should not dominate.
        t = clamp((log(1.0 + v) - logLo) / max(logHi - logLo, 1e-4), 0.0, 1.0);
    }

    // Per-particle spread around the dynamics-driven temperature. A real
    // stellar population is a mixture at every radius, not one colour per
    // orbit, and that mixture is most of what makes a star field colourful.
    // The skew mimics an initial mass function: mostly cool, with a thin tail
    // of hot bright ones. 0.357 is the mean of pow(r, 1.8) on [0,1), so the
    // offset stays centred and variety does not shift the overall balance.
    if (colorMode != 2 && variety > 0.0) {
        uint id = (hasIds != 0) ? ids[idx] : idx;
        float r = hash01(id * 2654435761u + 1u);
        t = clamp(t + (pow(r, 1.8) - 0.357) * variety * 1.5, 0.0, 1.0);
    }

    // Geometric rather than linear interpolation in temperature. Blackbody
    // hue changes fast below ~4000K and barely at all above ~7000K, so a
    // linear ramp spends most of its range in the near-white end and throws
    // away every red and amber.
    float kelvin = tempLow * pow(tempHigh / tempLow, t);

    vec3 color = (colorMode == 2) ? vec3(1.0, 0.96, 0.92) : blackbody(kelvin);

    // Hotter stars really are far more luminous, but weighting brightness by
    // t^2 let them dominate every dense region and additive blending then
    // summed those to white. A gentler slope keeps the cool population
    // visible instead of drowning it.
    float brightness = intensity * mix(0.5, 1.0, t);

    uint base = idx * 6;
    vertices[base + 0] = positions[idx].x;
    vertices[base + 1] = positions[idx].y;
    vertices[base + 2] = 0.0;
    vertices[base + 3] = color.r * brightness;
    vertices[base + 4] = color.g * brightness;
    vertices[base + 5] = color.b * brightness;
}

#version 430 core

// Per-particle HDR colour from the Planckian locus.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer PositionBuffer { vec2 positions[]; };
layout(std430, binding = 1) readonly buffer VelocityBuffer { vec2 velocities[]; };
layout(std430, binding = 2) writeonly buffer VertexBuffer  { float vertices[]; };
layout(std430, binding = 3) readonly buffer MassBuffer     { float masses[]; };
layout(std430, binding = 4) readonly buffer IdBuffer       { uint ids[]; };

uniform int particleCount;
uniform int colorMode;      // 0 speed, 1 mass, 2 monochrome
uniform int hasMass;
// Log-space window the scalar maps across, calibrated from the data.
uniform float logLo;
uniform float logHi;
uniform float tempLow;
uniform float tempHigh;
uniform float intensity;
uniform int hasIds;
uniform float variety;

vec3 blackbody(float kelvin) {
    float t = clamp(kelvin, 1700.0, 25000.0);
    float t2 = t * t;
    float t3 = t2 * t;

    float x = (t < 4000.0)
        ? (-0.2661239e9 / t3 - 0.2343589e6 / t2 + 0.8776956e3 / t + 0.179910)
        : (-3.0258469e9 / t3 + 2.1070379e6 / t2 + 0.2226347e3 / t + 0.240390);

    float x2 = x * x;
    float x3 = x2 * x;

    float y;
    if (t < 2222.0)
        y = -1.1063814 * x3 - 1.34811020 * x2 + 2.18555832 * x - 0.20219683;
    else if (t < 4000.0)
        y = -0.9549476 * x3 - 1.37418593 * x2 + 2.09137015 * x - 0.16748867;
    else
        y =  3.0817580 * x3 - 5.87338670 * x2 + 3.75112997 * x - 0.37001483;

    // xyY (Y = 1) -> XYZ -> linear sRGB.
    float Y = 1.0;
    float X = (Y / y) * x;
    float Z = (Y / y) * (1.0 - x - y);

    vec3 rgb = mat3( 3.2404542, -0.9692660,  0.0556434,
                    -1.5371385,  1.8760108, -0.2040259,
                    -0.4985314,  0.0415560,  1.0572252) * vec3(X, Y, Z);

    rgb = max(rgb, vec3(0.0));
    return rgb / max(max(rgb.r, max(rgb.g, rgb.b)), 1e-4);
}

// Deterministic per-particle value in [0,1).
float hash01(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return float(x) * (1.0 / 4294967296.0);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(particleCount)) return;

    float t = 0.0;
    if (colorMode != 2) {
        float v = (colorMode == 0) ? length(velocities[idx])
                                   : (hasMass != 0 ? masses[idx] : 1.0);
        t = clamp((log(1.0 + v) - logLo) / max(logHi - logLo, 1e-4), 0.0, 1.0);
    }

    if (colorMode != 2 && variety > 0.0) {
        uint id = (hasIds != 0) ? ids[idx] : idx;
        float r = hash01(id * 2654435761u + 1u);
        t = clamp(t + (pow(r, 1.8) - 0.357) * variety * 1.5, 0.0, 1.0);
    }

    float kelvin = tempLow * pow(tempHigh / tempLow, t);

    vec3 color = (colorMode == 2) ? vec3(1.0, 0.96, 0.92) : blackbody(kelvin);

    float brightness = intensity * mix(0.5, 1.0, t);

    uint base = idx * 6;
    vertices[base + 0] = positions[idx].x;
    vertices[base + 1] = positions[idx].y;
    vertices[base + 2] = 0.0;
    vertices[base + 3] = color.r * brightness;
    vertices[base + 4] = color.g * brightness;
    vertices[base + 5] = color.b * brightness;
}
